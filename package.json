{
  "name": "react-playlist-player",
  "version": "1.2.6",
  "description": "A React component for playing playlists",
  "author": "daniel sarmiento cordero",
  "email": "champi@champi.io",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "ui",
    "music"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/champi-dev/react-playlist-player"
  },
  "private": false,
  "dependencies": {
    "firebase": "^13.1.0",
    "mobx": "^5.15.4",
    "mobx-react": "^6.2.2",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-scripts": "^4.0.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npx vitest run"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.14.5",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@playwright/test": "^1.48.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/react": "^12.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "sass": "^1.79.6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "scripts/**/*.js",
      "!src/**/*.test.js",
      "!src/setupTests.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 100
      }
    }
  }
}
